<script>
(function () {
  var form = document.getElementById('lead-form');
  var err = document.getElementById('f-error');
  var btn = document.getElementById('f-submit');
  var done = document.getElementById('f-done');
  var dateInput = document.getElementById('f-date');

  // Bugundan oldingi sanani tanlab bo'lmaydi
  var t = new Date();
  dateInput.min = t.getFullYear() + '-' + String(t.getMonth() + 1).padStart(2, '0') + '-' + String(t.getDate()).padStart(2, '0');

  // UTM belgilarini olish (lead qayerdan kelganini bilish uchun)
  var q = new URLSearchParams(location.search);
  var utm = {};
  ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (k) {
    if (q.get(k)) utm[k] = q.get(k);
  });

  form.addEventListener('input', function () { err.textContent = ''; });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var data = {
      name: form.name.value.trim(),
      phone: form.phone.value.trim(),
      date: form.date.value,
      time: form.time.value
    };
    var digits = data.phone.replace(/\D/g, '');
    if (!data.name) return (err.textContent = 'Iltimos, ismingizni kiriting.');
    if (digits.length < 9) return (err.textContent = "Telefon raqamni to'liq kiriting.");
    if (!data.date) return (err.textContent = 'Kelish sanasini tanlang.');
    if (!data.time) return (err.textContent = 'Qulay vaqtni tanlang.');

    var payload = Object.assign({}, data, utm, {
      page: location.href,
      created_at: new Date().toISOString()
    });

    btn.disabled = true;
    btn.textContent = 'Yuborilmoqda...';

    var send = WEBHOOK_URL
      ? fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload)
        })
      : Promise.resolve();

    send.then(function () {
      if (window.fbq) fbq('track', 'Lead');
      showDone(data);
    }).catch(function () {
      err.textContent = "Xatolik yuz berdi. Iltimos, qayta urinib ko'ring yoki bizga qo'ng'iroq qiling.";
    }).finally(function () {
      btn.disabled = false;
      btn.textContent = 'Konsultatsiyaga yozilish';
    });
  });

  function showDone(d) {
    document.getElementById('d-title').textContent = 'Rahmat, ' + d.name + '!';
    document.getElementById('d-text').textContent =
      'Arizangiz qabul qilindi: ' + d.date + ', ' + d.time + '. Tez orada ' + d.phone + " raqamiga qo'ng'iroq qilamiz.";
    form.style.display = 'none';
    done.classList.add('show');
  }

  document.getElementById('f-again').addEventListener('click', function () {
    form.reset();
    done.classList.remove('show');
    form.style.display = '';
  });
})();
</script>
</body>
</html>
