<style>
  :root{--accent:#22C55E;--accent-soft:#4ADE80;--bg:#0A0D0B;--bg2:#0F1411;--card:#111613;--line:#1E2621;--line2:#2A332D;--muted:#A9B4AD;--text:#E8EDE9;--green-bg:#0F1A13;--green-line:#1F3A2A}
  *{box-sizing:border-box}
  html{scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--text);font-family:Manrope,system-ui,sans-serif;-webkit-font-smoothing:antialiased}
  a{color:var(--accent-soft);text-decoration:none}a:hover{color:#86EFAC}
  h1,h2,h3{color:#fff;margin:0}
  p{margin:0}
  .wrap{max-width:1200px;margin:0 auto;padding-left:24px;padding-right:24px}
  .alt{background:var(--bg2);border-top:1px solid #1A211C;border-bottom:1px solid #1A211C}
  .sec{padding-top:96px;padding-bottom:96px}
  .eyebrow{color:var(--accent-soft);font-size:14px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .h2{font-size:clamp(30px,4vw,46px);line-height:1.15;font-weight:800;letter-spacing:-.03em}
  .lead{font-size:18px;line-height:1.65;color:var(--muted)}
  .stack{display:flex;flex-direction:column;gap:16px}
  .btn{display:inline-flex;align-items:center;justify-content:center;padding:18px 28px;border-radius:14px;font-size:17px;font-weight:700}
  .btn-primary{background:var(--accent);color:var(--bg)}.btn-primary:hover{color:var(--bg);filter:brightness(1.08)}
  .btn-ghost{border:1px solid var(--line2);color:var(--text)}.btn-ghost:hover{color:#fff;border-color:#3A463E}

  header .wrap{padding-top:24px;padding-bottom:24px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:16px}
  .logo{display:flex;align-items:center;gap:12px;color:#fff;font-size:20px;font-weight:800;letter-spacing:-.02em}.logo:hover{color:#fff}
  .logo-mark{width:40px;height:40px;border-radius:12px;background:var(--accent);display:flex;align-items:center;justify-content:center}
  nav{display:flex;flex-wrap:wrap;align-items:center;gap:28px;font-size:15px;font-weight:600}
  nav a{color:#C3CCC6}
  nav .nav-cta{padding:12px 20px;border-radius:999px;background:var(--accent);color:var(--bg);font-weight:700}nav .nav-cta:hover{color:var(--bg)}

  .hero{padding-top:72px;padding-bottom:96px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:56px;align-items:center}
  .badge{align-self:flex-start;padding:8px 14px;border-radius:999px;border:1px solid var(--green-line);background:var(--green-bg);color:var(--accent-soft);font-size:14px;font-weight:600}
  .hero h1{font-size:clamp(38px,5.5vw,68px);line-height:1.05;font-weight:800;letter-spacing:-.035em}
  .hero h1 span{color:var(--accent-soft)}
  .hero-text{display:flex;flex-direction:column;gap:28px}
  .hero-text p{font-size:19px;line-height:1.6;color:var(--muted);max-width:520px}
  .btns{display:flex;flex-wrap:wrap;gap:14px}
  .hero-card{border-radius:28px;background:var(--card);border:1px solid var(--line);min-height:440px;padding:32px;display:flex;flex-direction:column;gap:24px}
  .photo{flex-grow:1;border-radius:20px;background:#0C110E;border:1px dashed #2C3B31;display:flex;align-items:center;justify-content:center;color:#6B776F;font-size:15px;min-height:260px;text-align:center;padding:16px;overflow:hidden}
  .photo img{width:100%;height:100%;object-fit:cover;border-radius:20px}
  .stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .stat{padding:18px;border-radius:16px;background:var(--green-bg);border:1px solid var(--green-line)}
  .stat b{display:block;font-size:24px;font-weight:800;color:var(--accent-soft)}
  .stat span{display:block;font-size:14px;color:var(--muted);margin-top:4px}

  .grid{display:grid;gap:20px}
  .g4{grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr))}
  .g3{grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr))}
  .card{padding:28px;border-radius:20px;background:var(--bg);border:1px solid var(--line);display:flex;flex-direction:column;gap:14px}
  .card .num{width:48px;height:48px;border-radius:14px;background:var(--green-bg);border:1px solid var(--green-line);display:flex;align-items:center;justify-content:center;color:var(--accent-soft);font-weight:800;font-size:18px}
  .card h3{font-size:20px;font-weight:700}
  .card p{font-size:16px;line-height:1.6;color:var(--muted)}
  .svc{background:var(--card);border-radius:22px;padding:30px}
  .svc-top{display:flex;justify-content:space-between;align-items:center;gap:12px}
  .svc-top span{font-size:13px;color:#6B776F;font-weight:700}
  .svc .price{margin-top:auto;padding-top:8px;font-size:15px;font-weight:600;color:var(--accent-soft)}
  .sec-head{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:24px;margin-bottom:48px}

  .tips{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(320px,100%),1fr));gap:56px}
  .tip{display:flex;gap:16px;align-items:flex-start;padding:20px 22px;border-radius:16px;background:var(--bg);border:1px solid var(--line);font-size:17px;line-height:1.5}
  .check{flex-shrink:0;width:28px;height:28px;border-radius:999px;background:var(--accent);display:flex;align-items:center;justify-content:center}

  .book{border-radius:32px;background:var(--green-bg);border:1px solid var(--green-line);padding:clamp(24px,5vw,64px);display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:48px;align-items:start}
  .contacts{display:flex;flex-direction:column;gap:12px;margin-top:8px;font-size:16px;color:#C3CCC6}
  .form-box{padding:32px;border-radius:24px;background:var(--bg);border:1px solid var(--line)}
  form{display:flex;flex-direction:column;gap:20px}
  .field{display:flex;flex-direction:column;gap:8px}
  .field label{font-size:15px;font-weight:600}
  .row2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  input,select{height:54px;padding:0 16px;border-radius:14px;border:1px solid var(--line2);background:var(--card);color:#fff;font-size:16px;font-family:inherit;width:100%;color-scheme:dark}
  input::placeholder{color:#6B776F}
  input:focus,select:focus{outline:2px solid var(--accent);outline-offset:1px;border-color:var(--accent)}
  .error{font-size:15px;color:#FCA5A5;min-height:0}
  .error:empty{display:none}
  .submit{height:58px;border:0;border-radius:14px;background:var(--accent);color:var(--bg);font-family:inherit;font-size:17px;font-weight:800;cursor:pointer}
  .submit:hover{filter:brightness(1.08)}
  .submit:disabled{opacity:.6;cursor:wait}
  .note{font-size:13px;color:#8A968E;text-align:center}
  .done{display:none;flex-direction:column;align-items:center;text-align:center;gap:16px;padding:40px 8px}
  .done.show{display:flex}
  .done h3{font-size:26px;font-weight:800}
  .done p{font-size:16px;line-height:1.6;color:var(--muted)}
  .again{margin-top:8px;height:48px;padding:0 22px;border-radius:12px;border:1px solid var(--line2);background:transparent;color:var(--text);font-family:inherit;font-size:15px;font-weight:600;cursor:pointer}

  footer{border-top:1px solid #1A211C}
  footer .wrap{padding-top:32px;padding-bottom:32px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;font-size:14px;color:#8A968E}

  @media (max-width:640px){
    nav{gap:16px}
    nav a:not(.nav-cta){display:none}
    .sec{padding-top:64px;padding-bottom:64px}
    .hero{padding-top:32px;padding-bottom:64px;gap:36px}
    .hero-card{min-height:0;padding:20px}
    .form-box{padding:20px}
    .row2{grid-template-columns:1fr}
  }
</style>
</head>
